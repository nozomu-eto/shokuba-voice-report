# Bedrock remains unavailable unless both switches are deliberately enabled.
BEDROCK_ANALYSIS_ENABLED=false
BEDROCK_LIVE_APPROVED=false

# Safe placeholders. Values are allowlisted by the server configuration parser.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_REGION=ap-northeast-1
BEDROCK_MAX_INPUT_CHARS=12000
BEDROCK_MAX_OUTPUT_TOKENS=1024
BEDROCK_TIMEOUT_MS=10000
